#!/usr/bin/python3
"""Pushes to the phone when an agent needs you or finishes: straight to APNs with this Mac's
push key, or through penfold-relay on a Mac without one.

Follows `hc events` (the same stream the app reads) and sends an alert when an agent's status
turns blocked (응답 필요) or goes from working to done/idle (끝남). The phone registers itself
by writing ~/.config/penfold/devices/<id>.json ({"token", "env": sandbox|production, "ticket"}).
The ticket is what the relay checks: it forwards only alerts whose ticket matches the token.
"mutedUntil" (seconds since 1970) in that file is the phone turning its alerts off until then:
the time is here, so they come back by themselves, with the app closed.

  penfold-push [--key-id X --team T --key PATH]   (defaults: this Mac's team key, below)
  penfold-push --test                             one test alert to every device, then exit

While an agent works or waits for an answer it keeps the Mac from idle sleep (`caffeinate -i`),
so a job left running doesn't stop halfway and the phone can still reach the Mac. A closed lid on
battery still sleeps; that's macOS's call.

Runs under launchd (mac/co.notique.penfold-push.plist). Standard library only: the JWT is signed
with `openssl`, sent with `curl --http2`, and never printed or put on a command line.
"""

import argparse, base64, glob, json, os, subprocess, sys, tempfile, time, urllib.error, urllib.request

HC = os.path.expanduser("~/.local/bin/hc")
DEVICES = os.path.expanduser("~/.config/penfold/devices")
TOPIC = "co.notique.penfold.app"  # the app's bundle ID
HOSTS = {"sandbox": "api.sandbox.push.apple.com", "production": "api.push.apple.com"}
RELAY = "https://penfold-relay.vercel.app/api/push"
KEY_DIR = "~/.config/" + "secrets/apns"
KINDS = {"permission": "권한 요청", "question": "질문", "auth": "로그인 필요"}
KINDS_EN = {"permission": "Permission", "question": "Question", "auth": "Login needed"}
QUIET_SECONDS = 20  # the same alert for the same agent, at most this often
# What the running daemon can do, for the app to read: new files alone don't change a daemon
# that's already running. 2: honors "mutedUntil".
VERSION = 2
VERSION_FILE = os.path.expanduser("~/.config/penfold/push-version")


def log(*parts):
    print(time.strftime("%H:%M:%S"), *parts, file=sys.stderr, flush=True)


def b64url(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def der_to_raw(der):
    """openssl signs ES256 as DER (SEQUENCE of r, s); JWT wants r‖s, 32 bytes each."""
    def integer(at):
        assert der[at] == 0x02
        length = der[at + 1]
        value = der[at + 2:at + 2 + length].lstrip(b"\x00")
        return value.rjust(32, b"\x00"), at + 2 + length
    at = 2 if der[1] < 0x80 else 3
    r, at = integer(at)
    s, _ = integer(at)
    return r + s


class Apns:
    def __init__(self, key, key_id, team):
        self.key, self.key_id, self.team = key, key_id, team
        self.jwt, self.made = None, 0

    def token(self):
        # Apple accepts a token for an hour and refuses new ones more often than every 20 minutes.
        if self.jwt and time.time() - self.made < 40 * 60:
            return self.jwt
        header = b64url(json.dumps({"alg": "ES256", "kid": self.key_id}).encode())
        claims = b64url(json.dumps({"iss": self.team, "iat": int(time.time())}).encode())
        signing = f"{header}.{claims}".encode()
        der = subprocess.run(["openssl", "dgst", "-sha256", "-sign", self.key, "-binary"],
                             input=signing, capture_output=True, check=True).stdout
        self.jwt, self.made = f"{header}.{claims}.{b64url(der_to_raw(der))}", time.time()
        return self.jwt

    def send(self, device, payload, collapse=None):
        host = HOSTS.get(device.get("env"), HOSTS["production"])
        with tempfile.TemporaryDirectory() as tmp:
            headers = os.path.join(tmp, "headers")
            fd = os.open(headers, os.O_WRONLY | os.O_CREAT, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(f"authorization: bearer {self.token()}\n")
                f.write(f"apns-topic: {TOPIC}\napns-push-type: alert\napns-priority: 10\n")
                if collapse:
                    f.write(f"apns-collapse-id: {collapse}\n")
            result = subprocess.run(
                ["curl", "-sS", "--http2", "-o", "-", "-w", "\n%{http_code}", "-H", f"@{headers}",
                 "--data-binary", "@-", f"https://{host}/3/device/{device['token']}"],
                input=json.dumps(payload, ensure_ascii=False).encode(), capture_output=True)
        out = result.stdout.decode(errors="replace").rsplit("\n", 1)
        code = out[-1].strip() if out else ""
        reason = out[0].strip() if len(out) > 1 else result.stderr.decode(errors="replace").strip()
        return code, reason


class Relay:
    """For a Mac without the push key: penfold-relay signs and sends."""

    def send(self, device, payload, collapse=None):
        if not device.get("ticket"):
            return "000", "no relay ticket (open the app once to get one)"
        body = {"token": device["token"], "env": device.get("env", "production"), "ticket": device["ticket"],
                "payload": payload, "collapse": collapse}
        request = urllib.request.Request(RELAY, data=json.dumps(body, ensure_ascii=False).encode(),
                                         headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                result = json.load(response)
            return str(result.get("status", "")), result.get("reason", "")
        except urllib.error.HTTPError as error:
            return str(error.code), error.read()[:200].decode(errors="replace")
        except (OSError, ValueError) as error:
            return "000", type(error).__name__


def devices():
    found = []
    for path in glob.glob(os.path.join(DEVICES, "*.json")):
        try:
            with open(path) as f:
                device = json.load(f)
            if isinstance(device.get("token"), str):
                device["path"] = path
                found.append(device)
        except (OSError, ValueError):
            pass
    return found


def muted(device, now=None):
    until = device.get("mutedUntil")
    return isinstance(until, (int, float)) and (time.time() if now is None else now) < until


def deliver(apns, payload, collapse=None, even_muted=False):
    """`payload` is the alert, or a function of the device's language ("ko", "en") giving it."""
    for device in devices():
        if muted(device) and not even_muted:
            log("muted", device.get("name") or os.path.basename(device["path"]))
            continue
        body = payload(device.get("lang") or "ko") if callable(payload) else payload
        if device.get("mac"):
            # The phone's id for this Mac: a tap opens the agent on this Mac, not another one.
            body = {**body, "mac": device["mac"]}
        code, reason = apns.send(device, body, collapse)
        name = device.get("name") or os.path.basename(device["path"])
        if code == "200":
            log("sent", name, body["aps"]["alert"].get("title", ""))
        else:
            log("failed", name, code, reason[:200])
            if code == "410" or "BadDeviceToken" in reason or "DeviceTokenNotForTopic" in reason:
                # The app was deleted or the token changed; it writes a new file when it opens.
                os.remove(device["path"])


def alert(terminal, before, after, lang="ko"):
    """What to say when `terminal` goes from status `before` to `after`, or None. In the
    phone's language (it writes "lang" with its token)."""
    en = lang == "en"
    status = terminal.get("status") or {}
    if not status.get("app"):
        return None  # a plain shell
    title = terminal.get("title") or terminal.get("name") or status.get("app")
    where = (terminal.get("labels") or {}).get("where", "").split(" / ")[0]
    # One shape for every alert: what state at a glance and which agent (title), its space
    # (subtitle), then the one detail worth reading (body).
    if after == "blocked" and before != "blocked":
        reason = (KINDS_EN if en else KINDS).get(status.get("kind"), "Needs you" if en else "응답 필요")
        detail = status.get("msg") or status.get("title")
        waiting = "waiting for you" if en else "답을 기다려요"
        return "blocked", {"title": f"🙋 {title}", "subtitle": where,
                           "body": f"{reason} · {detail}" if detail else f"{reason} · {waiting}"}
    if before == "working" and after in ("done", "idle"):
        return "done", {"title": f"✅ {title}", "subtitle": where,
                        "body": status.get("msg") or ("Finished" if en else "작업을 마쳤어요")}
    return None


class Awake:
    """Holds `caffeinate -i` while any agent is busy (working, or blocked on an answer)."""

    BUSY = ("working", "blocked")

    def __init__(self, start=None):
        self.start = start or (lambda: subprocess.Popen(["/usr/bin/caffeinate", "-i", "-w", str(os.getpid())],
                                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        self.process = None

    def update(self, terminals):
        busy = any((t.get("status") or {}).get("state") in self.BUSY for t in terminals.values())
        if busy and self.process is None:
            self.process = self.start()
            log("keeping the Mac awake while agents work")
        elif not busy and self.process is not None:
            self.process.terminate()
            self.process = None
            log("letting the Mac sleep again")


def follow(apns, awake):
    terminals, sent = {}, {}
    process = subprocess.Popen([HC, "events", "--json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    log("following hc events")
    for raw in process.stdout:
        try:
            message = json.loads(raw)
        except ValueError:
            continue
        params = message.get("params") or {}
        if "terminals" in message or message.get("method") == "missed":
            # A snapshot: the state to compare against, nothing to announce.
            records = message.get("terminals") or params.get("terminals") or []
            terminals = {t["address"]: t for t in records if isinstance(t, dict) and "address" in t}
            awake.update(terminals)
            continue
        if message.get("method") != "event":
            continue
        kind, address, data = params.get("type"), params.get("terminal"), params.get("data") or {}
        if kind in ("created", "restarted") and isinstance(data, dict):
            terminals[address] = data
            continue
        if kind == "removed":
            terminals.pop(address, None)
            awake.update(terminals)
            continue
        terminal = terminals.get(address)
        if terminal is None:
            continue
        if kind == "title":
            terminal["title"] = data.get("title")
        elif kind == "labels":
            terminal["labels"] = data.get("labels") or {}
        elif kind == "status":
            before = (terminal.get("status") or {}).get("state")
            terminal["status"] = data.get("status")
            after = (terminal.get("status") or {}).get("state")
            awake.update(terminals)
            said = alert(terminal, before, after)
            if not said:
                continue
            what, _ = said
            key = (address, what)
            if time.time() - sent.get(key, 0) < QUIET_SECONDS:
                continue
            sent[key] = time.time()
            snapshot = dict(terminal)
            deliver(apns, lambda lang: {"aps": {"alert": alert(snapshot, before, after, lang)[1], "sound": "default",
                                                "thread-id": address}, "address": address},
                    collapse=f"{address}-{what}")
    process.wait()


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    # The team's APNs key (shared with MMC and Twynning; see infra inventory). The file is read
    # by openssl only; the key itself is never printed.
    parser.add_argument("--key-id", default="428R996579")
    parser.add_argument("--team", default="7M2DZPHB8R")
    parser.add_argument("--key", help="default: ~/.config/secrets/apns/AuthKey_<key-id>.p8")
    parser.add_argument("--test", action="store_true")
    args = parser.parse_args()
    key = os.path.expanduser(args.key or os.path.join(KEY_DIR, f"AuthKey_{args.key_id}.p8"))
    apns = Apns(key, args.key_id, args.team) if os.path.exists(key) else Relay()
    log("sending", "with this Mac's key" if isinstance(apns, Apns) else "through penfold-relay")
    if args.test:
        if not devices():
            log("no devices in", DEVICES, "- open the app once")
            return 1
        deliver(apns, lambda lang: {"aps": {"alert": {"title": "Penfold", "body": "Alerts are on" if lang == "en" else "푸시가 연결됐어요"},
                                            "sound": "default"}}, even_muted=True)  # asked for just now
        return 0
    os.makedirs(os.path.dirname(VERSION_FILE), exist_ok=True)
    with open(VERSION_FILE, "w") as f:
        f.write(f"{VERSION}\n")
    backoff, awake = 1, Awake()
    while True:
        started = time.time()
        try:
            follow(apns, awake)
        except Exception as error:  # keep going; launchd restarts us only if we exit
            log("error", type(error).__name__)
        backoff = 1 if time.time() - started > 60 else min(backoff * 2, 60)
        time.sleep(backoff)


if __name__ == "__main__":
    sys.exit(main())
